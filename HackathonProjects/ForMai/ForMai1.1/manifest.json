{
  "manifest_version": 3,
  "name": "ForMai Form Assistant",
  "version": "1.1",
  "description": "AI assistant that explains online form fields — clearly, safely, and privately. Click a field or snip any form area to get an instant explanation.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    
    "https://generativelanguage.googleapis.com/*",
    "https://api.aiccio.com/*",
    "https://openrouter.ai/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/favicon.ico"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ai.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.html",
        "style.css",
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "128": "icons/favicon.ico"
  }
}
